{
  "name": "flag-dash",
  "version": "2.0.0",
  "description": "Minimal two-player flag guessing duel",
  "main": "dist/server/index.js",
  "scripts": {
    "build": "rimraf dist public/assets && tsc -p tsconfig.server.json && tsc -p tsconfig.client.json",
    "start": "node dist/server/index.js",
    "dev": "tsx watch src/server/index.ts",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "typecheck": "tsc --noEmit -p tsconfig.server.json && tsc --noEmit -p tsconfig.client.json",
    "download-flags": "tsx scripts/downloadFlags.ts"
  },
  "keywords": ["flags", "multiplayer", "socket.io"],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "express": "^5.1.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.2",
    "@types/node": "^22.10.1",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.4.5",
    "vitest": "^1.3.1"
  }
}
